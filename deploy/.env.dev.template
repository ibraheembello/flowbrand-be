# ─────────────────────────────────────────────────────────────────────────────
#  FlowBrand BE — dev environment file for EC2
#
#  Place this file on the EC2 server at:  ${DEPLOY_DIR}/.env.dev
#  (DEPLOY_DIR is set in GitHub repo Variables, typically /home/ubuntu/app)
#
#  The NestJS app's ConfigModule loads `.env.${PROFILE}` — and the CI deploy
#  passes PROFILE=dev. So this file MUST be named `.env.dev` and live in
#  DEPLOY_DIR.
#
#  Fill in every <PLACEHOLDER>. Do NOT commit this file with real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──
PROFILE=dev
NODE_ENV=development
PORT=3008

# ── Database (matches server-setup.sh defaults; replace password) ──
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=flowbrand
DB_PASSWORD=<PASTE_PG_PASSWORD_FROM_SERVER_SETUP_OUTPUT>
DB_NAME=flowbrand_dev
DB_DATABASE=flowbrand_dev
DB_SSL=false
DB_ENTITIES=dist/src/modules/**/entities/**/*.entity{.ts,.js}
DB_MIGRATIONS=dist/**/migrations/*{.ts,.js}

# ── Redis (local on the EC2) ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──
JWT_SECRET=<RANDOM_LONG_SECRET_AT_LEAST_64_CHARS>
JWT_EXPIRY_TIMEFRAME=3600

# ── Admin ──
ADMIN_SECRET_KEY=<RANDOM_LONG_SECRET>

# ── Google OAuth (optional — leave empty if not using) ──
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

# ── Mail (Mailtrap sandbox for dev; replace with real SMTP for prod) ──
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SERVER_NAME=api
SMTP_USER=<MAILTRAP_USER>
SMTP_PASSWORD=<MAILTRAP_PASSWORD>

# ── Resend SMTP (takes precedence over SMTP_* above when RESEND_SMTP_API_KEY is set) ──
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USER=resend
RESEND_SMTP_API_KEY=
MAIL_FROM="FlowBrand <flowbrand@hng14.com>"

# ── Frontend URL (used in password-reset email links etc.) ──
FRONTEND_URL=http://<EC2_PUBLIC_IP>:3008
